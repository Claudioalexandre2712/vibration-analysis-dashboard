{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "functions": {
    "app.py": {
      "maxDuration": 60,
      "excludeFiles": "{.venv*/**,.tools/**,node_modules/**,tests/**,**/__pycache__/**,*.db,*.db-*,*.csv,*.spec,logs/**,temp/**,build/**,dist/**,documentacao/**}"
    }
  },
  "headers": [{
    "source": "/(.*)",
    "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "same-origin"},
      {"key": "X-Frame-Options", "value": "DENY"}
    ]
  }]
}
